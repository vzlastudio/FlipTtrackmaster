# ============================================
# FLIPTRACK - Variables de entorno (ejemplo)
# ============================================

# NVIDIA NIM (OBLIGATORIA): motor IA principal — DeepSeek V4 Flash.
# Obtén tu key en https://build.nvidia.com (gratis). Ejemplo: nvapi-xxxx...
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# Firecrawl (OBLIGATORIA para escaneo de tiendas): https://firecrawl.dev
FIRECRAWL_API_KEY=""

# Browserbase (OPCIONAL — complemento a Firecrawl para sitios dinámicos): https://browserbase.com
# Stagehand usa Browserbase para navegar sitios con Cloudflare, lazy-loading, etc.
# Tier gratuito: 100 hrs/mes. Solo necesitas la key si usas /api/scrape-smart.
BROWSERBASE_API_KEY=""

# CRON_SECRET: token que protege /api/cron-escaner (Bearer auth). Genera uno aleatorio.
CRON_SECRET=""

# APP_URL: URL de la app desplegada (self-references).
APP_URL="https://fliptrackmaster.vercel.app"

# GEMINI_API_KEY (OPCIONAL): SOLO si eliges un modelo gemini-* en Ajustes.
# El análisis por defecto usa DeepSeek (NVIDIA NIM) y NO necesita esta key.
GEMINI_API_KEY=""
